{
  "name": "karachi-traffic-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "pack": "SINGLE_FILE=1 vite build && node tools/pack_html.mjs",
    "preview": "vite preview --host",
    "playtest:sim": "node tools/playtest/sim.mjs",
    "playtest:balance": "node tools/playtest/balance.mjs",
    "playtest:metrics": "bash tools/playtest/metrics.sh",
    "playtest:browser": "node tools/playtest/browser.mjs",
    "test": "node --test tools/test/*.test.mjs",
    "test:e2e": "node tools/playtest/e2e-car-select.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
